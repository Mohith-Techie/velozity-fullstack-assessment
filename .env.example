# Used by the Prisma CLI (migrate, seed) and by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pm_dashboard"

# Required: HS256 key for signing access tokens (min 32 chars). The app refuses to start without it.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""

# Optional (defaults shown)
# PORT=3000
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7
# OVERDUE_SWEEP_CRON="0 * * * *"   # overdue-task sweep schedule, cron syntax in UTC
# JOBS_ENABLED=true                # set to false on extra API instances

# Optional: password given to every seeded user (defaults to "Password123!").
# SEED_USER_PASSWORD="Password123!"
